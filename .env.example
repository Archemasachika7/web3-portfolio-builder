# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Same Supabase project as the public site (3dportfolio). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER prefix this with NEXT_PUBLIC_ and never import
# it from a Client Component — it bypasses RLS entirely. Used only in
# Server Actions and Route Handlers under app/, and in middleware.ts for
# the auth session refresh.
SUPABASE_SERVICE_ROLE_KEY=

# The public portfolio's URL, for the admin's "Preview site" link and
# per-item "Preview" buttons. Browser-safe. Optional — lib/siteUrl.ts
# falls back to the live site when this isn't set.
NEXT_PUBLIC_SITE_URL=https://3dportfolio-gray.vercel.app
